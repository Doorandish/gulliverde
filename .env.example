# ============================================
# Gulliver — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# All variables with defaults will work for local development.

# ── Server ───────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────
# MongoDB connection string. Leave empty for in-memory mock data.
MONGODB_URI=mongodb://localhost:27017/gulliver

# ── Cache ────────────────────────────────────
# Redis URL. Leave empty for in-memory cache fallback.
REDIS_URL=redis://localhost:6379

# ── AI ───────────────────────────────────────
# Google Gemini API key. Leave empty for mock itinerary responses.
GEMINI_API_KEY=

# ── Weather ──────────────────────────────────
# OpenWeatherMap API key. Leave empty for mock weather data.
OPENWEATHER_API_KEY=

# ── Frontend ─────────────────────────────────
FRONTEND_URL=https://gulliver.doorandish.app

# ── Affiliate Partner IDs ────────────────────
# Optional. Appended as tracking params to partner redirect URLs.
OMIO_AFFILIATE_ID=
DB_AFFILIATE_ID=
BOOKING_AFFILIATE_ID=
GYG_AFFILIATE_ID=
